<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <!--
        Editors: org_manager / doc_manager of the organization, or
        ws_manager / doc_manager of the workspace. Other members read
        published documents only; published documents of public workspaces
        are readable by every user. Organization documents need an
        organization role: the portal shows them in a workspace context
        through its own checked, read-only path.
    -->

    <record id="itlingo_document_rule_admin" model="ir.rule">
        <field name="name">ITLingo Document: admin sees all</field>
        <field name="model_id" ref="model_itlingo_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('itlingo_core.group_itlingo_admin')])]"/>
    </record>

    <record id="itlingo_document_rule_member" model="ir.rule">
        <field name="name">ITLingo Document: read published in scope, editors read all</field>
        <field name="model_id" ref="model_itlingo_document"/>
        <field name="domain_force">['|', '|', '|',
            ('organization_id.role_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted'), ('role', 'in', ['org_manager', 'doc_manager'])]),
            ('project_id.workspace_role_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted'), ('role', 'in', ['ws_manager', 'doc_manager'])]),
            '&amp;', ('status', '=', 'published'),
                ('organization_id.role_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted')]),
            '&amp;', ('status', '=', 'published'), '|',
                ('project_id.is_public_workspace', '=', True),
                ('project_id.workspace_role_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted')])]</field>
        <field name="groups" eval="[(6, 0, [ref('itlingo_core.group_itlingo_member'), ref('base.group_portal')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itlingo_document_rule_portal" model="ir.rule">
        <field name="name">ITLingo Document: scope editors create, change and delete</field>
        <field name="model_id" ref="model_itlingo_document"/>
        <field name="domain_force">['|',
            ('organization_id.role_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted'), ('role', 'in', ['org_manager', 'doc_manager'])]),
            ('project_id.workspace_role_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted'), ('role', 'in', ['ws_manager', 'doc_manager'])])]</field>
        <field name="groups" eval="[(6, 0, [ref('itlingo_core.group_itlingo_member'), ref('base.group_portal')])]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</data>
</odoo>
