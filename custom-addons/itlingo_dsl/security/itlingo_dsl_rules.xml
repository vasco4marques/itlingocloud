<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <!--
        Read rules expose public catalog metadata. They grant READ only:
        authoring access comes from the maintainer write rules below, which
        apply only to family maintainers (the maintainer group carries the
        write ACLs). Administrators see and manage everything.
    -->

    <!-- Active family metadata is public; inactive families remain private. -->
    <record id="itlingo_dsl_family_rule_admin" model="ir.rule">
        <field name="name">ITLingo DSL Family: admin sees all</field>
        <field name="model_id" ref="model_itlingo_dsl_family"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_admin'))]"/>
    </record>

    <record id="itlingo_dsl_family_rule_manager" model="ir.rule">
        <field name="name">ITLingo DSL Family: active or maintained</field>
        <field name="model_id" ref="model_itlingo_dsl_family"/>
        <field name="domain_force">['|', ('active', '=', True), ('maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itlingo_dsl_family_rule_member" model="ir.rule">
        <field name="name">ITLingo DSL Family: active or maintained</field>
        <field name="model_id" ref="model_itlingo_dsl_family"/>
        <field name="domain_force">['|', ('active', '=', True), ('maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_member'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itlingo_dsl_family_rule_portal" model="ir.rule">
        <field name="name">ITLingo DSL Family: active or maintained</field>
        <field name="model_id" ref="model_itlingo_dsl_family"/>
        <field name="domain_force">['|', ('active', '=', True), ('maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- DSL version metadata for active and deprecated versions is public; drafts remain private to admins and family maintainers. -->
    <record id="itlingo_dsl_rule_admin" model="ir.rule">
        <field name="name">ITLingo DSL: admin sees all</field>
        <field name="model_id" ref="model_itlingo_dsl"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_admin'))]"/>
    </record>

    <record id="itlingo_dsl_rule_manager" model="ir.rule">
        <field name="name">ITLingo DSL: active or maintained</field>
        <field name="model_id" ref="model_itlingo_dsl"/>
        <field name="domain_force">['|', '&amp;', ('status', 'in', ['active', 'deprecated']), ('family_id.active', '=', True), ('family_id.maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itlingo_dsl_rule_member" model="ir.rule">
        <field name="name">ITLingo DSL: active or maintained</field>
        <field name="model_id" ref="model_itlingo_dsl"/>
        <field name="domain_force">['|', '&amp;', ('status', 'in', ['active', 'deprecated']), ('family_id.active', '=', True), ('family_id.maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_member'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itlingo_dsl_rule_portal" model="ir.rule">
        <field name="name">ITLingo DSL: active or maintained</field>
        <field name="model_id" ref="model_itlingo_dsl"/>
        <field name="domain_force">['|', '&amp;', ('status', 'in', ['active', 'deprecated']), ('family_id.active', '=', True), ('family_id.maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Maintainers author versions of the families they maintain only. -->
    <record id="itlingo_dsl_rule_maintainer" model="ir.rule">
        <field name="name">ITLingo DSL: maintainers author maintained families</field>
        <field name="model_id" ref="model_itlingo_dsl"/>
        <field name="domain_force">[('family_id.maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_itlingo_dsl_maintainer'))]"/>
    </record>


    <!-- Definition files are private to admins and assigned maintainers. -->
    <record id="itlingo_dsl_file_rule_admin" model="ir.rule">
        <field name="name">ITLingo DSL File: admin sees all</field>
        <field name="model_id" ref="model_itlingo_dsl_file"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_admin'))]"/>
    </record>

    <record id="itlingo_dsl_file_rule_manager" model="ir.rule">
        <field name="name">ITLingo DSL File: manager sees maintained DSL files</field>
        <field name="model_id" ref="model_itlingo_dsl_file"/>
        <field name="domain_force">[('dsl_id.family_id.maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itlingo_dsl_file_rule_member" model="ir.rule">
        <field name="name">ITLingo DSL File: member sees maintained DSL files</field>
        <field name="model_id" ref="model_itlingo_dsl_file"/>
        <field name="domain_force">[('dsl_id.family_id.maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_member'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itlingo_dsl_file_rule_portal" model="ir.rule">
        <field name="name">ITLingo DSL File: portal sees maintained DSL files</field>
        <field name="model_id" ref="model_itlingo_dsl_file"/>
        <field name="domain_force">[('dsl_id.family_id.maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itlingo_dsl_file_rule_maintainer" model="ir.rule">
        <field name="name">ITLingo DSL File: maintainers author maintained DSL files</field>
        <field name="model_id" ref="model_itlingo_dsl_file"/>
        <field name="domain_force">[('dsl_id.family_id.maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_itlingo_dsl_maintainer'))]"/>
    </record>

    <!--
        DSL resources follow their DSL's visibility: public and protected
        resources of active/deprecated versions are readable by signed-in
        portal/member users (anonymous users have no ACL); private resources
        and resources of drafts stay with family maintainers and admins.
        Modification needs the manager ACL plus family maintainership.
    -->
    <record id="itlingo_dsl_resource_rule_admin" model="ir.rule">
        <field name="name">ITLingo DSL Resource: admin sees all</field>
        <field name="model_id" ref="model_itlingo_dsl_resource"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_admin'))]"/>
    </record>

    <record id="itlingo_dsl_resource_rule_user" model="ir.rule">
        <field name="name">ITLingo DSL Resource: reads public DSL resources or maintained</field>
        <field name="model_id" ref="model_itlingo_dsl_resource"/>
        <field name="domain_force">['|', '&amp;', '&amp;', ('visibility', '!=', 'private'), ('dsl_id.status', 'in', ['active', 'deprecated']), ('dsl_id.family_id.active', '=', True), ('dsl_id.family_id.maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_member')), (4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itlingo_dsl_resource_rule_user_write" model="ir.rule">
        <field name="name">ITLingo DSL Resource: modifies maintained DSL resources only</field>
        <field name="model_id" ref="model_itlingo_dsl_resource"/>
        <field name="domain_force">[('dsl_id.family_id.maintainer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_member')), (4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Admins see and manage all organization resources -->
    <record id="itlingo_org_resource_rule_admin" model="ir.rule">
        <field name="name">ITLingo Org Resource: admin sees all</field>
        <field name="model_id" ref="model_itlingo_org_resource"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_admin'))]"/>
    </record>

    <!-- Members read public resources, or resources of organizations where they hold an accepted role -->
    <record id="itlingo_org_resource_rule_member" model="ir.rule">
        <field name="name">ITLingo Org Resource: member reads public or own org</field>
        <field name="model_id" ref="model_itlingo_org_resource"/>
        <field name="domain_force">['|', ('visibility', '=', 'public'), ('organization_id.role_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted')])]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_member'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal users read public resources, or resources of organizations where they hold an accepted role -->
    <record id="itlingo_org_resource_rule_portal" model="ir.rule">
        <field name="name">ITLingo Org Resource: portal reads public or own org</field>
        <field name="model_id" ref="model_itlingo_org_resource"/>
        <field name="domain_force">['|', ('visibility', '=', 'public'), ('organization_id.role_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted')])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Public visibility never grants modification. Organization resources
        have no portal UI, so they follow the portal's organization document
        editor roles (org_manager, doc_manager) of the owning organization.
    -->
    <record id="itlingo_org_resource_rule_member_write" model="ir.rule">
        <field name="name">ITLingo Org Resource: org editors modify own org only</field>
        <field name="model_id" ref="model_itlingo_org_resource"/>
        <field name="domain_force">[('organization_id.role_ids', 'any', [('user_id', '=', user.id), ('state', '=', 'accepted'), ('role', 'in', ['org_manager', 'doc_manager'])])]</field>
        <field name="groups" eval="[(4, ref('itlingo_core.group_itlingo_member'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</data>
</odoo>
