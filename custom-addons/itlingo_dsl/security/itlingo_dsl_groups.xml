<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!--
        Technical group whose membership mirrors itlingo.dsl.family.maintainer_ids
        (kept in sync by the model). It carries the DSL/file write ACLs; the
        maintainer record rules restrict them to the families each user
        maintains. Family identity, maintainers, and publication stay
        admin-only.
    -->
    <record id="group_itlingo_dsl_maintainer" model="res.groups">
        <field name="name">ITLingo DSL Maintainer</field>
        <field name="comment">Users who maintain at least one DSL. Membership is managed automatically from each DSL's maintainers; it grants navigation access to /dsl but not edit rights.</field>
    </record>

</data>
</odoo>
