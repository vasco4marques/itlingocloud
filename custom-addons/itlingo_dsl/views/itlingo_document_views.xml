<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="itlingo_document_view_tree_dsl" model="ir.ui.view">
        <field name="name">itlingo.document.tree.dsl</field>
        <field name="model">itlingo.document</field>
        <field name="inherit_id" ref="itlingo_core.itlingo_document_view_tree"/>
        <field name="arch" type="xml">
            <field name="document_type_id" position="after">
                <field name="dsl_family_id" optional="show"/>
                <field name="dsl_version_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="itlingo_document_view_form_dsl" model="ir.ui.view">
        <field name="name">itlingo.document.form.dsl</field>
        <field name="model">itlingo.document</field>
        <field name="inherit_id" ref="itlingo_core.itlingo_document_view_form"/>
        <field name="arch" type="xml">
            <field name="document_type_id" position="after">
                <field name="dsl_family_id"/>
                <field name="dsl_version_id"
                       domain="[('family_id', '=', dsl_family_id)]"/>
            </field>
        </field>
    </record>

    <record id="itlingo_document_view_search_dsl" model="ir.ui.view">
        <field name="name">itlingo.document.search.dsl</field>
        <field name="model">itlingo.document</field>
        <field name="inherit_id" ref="itlingo_core.itlingo_document_view_search"/>
        <field name="arch" type="xml">
            <field name="document_type_id" position="after">
                <field name="dsl_family_id"/>
                <field name="dsl_version_id"/>
            </field>
            <filter name="group_type" position="after">
                <filter name="group_dsl_family" string="DSL Family"
                        context="{'group_by': 'dsl_family_id'}"/>
                <filter name="group_dsl_version" string="DSL Version"
                        context="{'group_by': 'dsl_version_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
